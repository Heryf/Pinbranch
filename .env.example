# ============================================
# Pintree 环境变量配置
# ============================================
# 复制此文件为 .env.local（本地开发）或在 Vercel 项目设置中配置这些变量

# ---------- 数据库 ----------
# PostgreSQL 数据库连接字符串
# 本地开发: postgresql://postgres@localhost:5432/pintree
# Vercel 部署: 使用 Vercel Postgres 或外部 PostgreSQL 服务（如 Neon、Supabase）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ---------- NextAuth 认证 ----------
# NextAuth 密钥，用于 JWT 签名
# 生成方式: openssl rand -base64 32
# 或在 Node.js 中运行: require('crypto').randomBytes(32).toString('base64')
NEXTAUTH_SECRET="your-secret-key-here"

# NextAuth URL
# 本地开发: http://localhost:3000
# 生产环境: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ---------- 应用配置 ----------
# 应用公开 URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- 管理员账号 ----------
# 首次部署后用于初始化管理员账号
ADMIN_EMAIL="admin@pintree.io"
ADMIN_PASSWORD="your-secure-password"
